{
  "name": "chiban-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:viewer": "npm run dev -w @chiban/viewer",
    "dev:input": "npm run dev -w @chiban/input",
    "build": "npm run build --workspaces --if-present",
    "build:viewer": "npm run build -w @chiban/viewer",
    "build:input": "npm run build -w @chiban/input"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
